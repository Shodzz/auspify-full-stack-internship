{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio site with a contact form backed by Express + SQLite",
  "author": "Shady Mamdouh Kamal Labib Zaki",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "messages": "node --env-file-if-exists=.env scripts/list-messages.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0"
  }
}

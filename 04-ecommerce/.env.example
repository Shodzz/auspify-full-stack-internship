# Copy this file to .env and fill in the blanks. Never commit .env.

PORT=3004
DB_FILE=data/store.db

# Long random string for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true when the site is served over HTTPS
COOKIE_SECURE=false

# Passwords for the two local demo accounts that `npm run seed` creates:
#   admin@example.com     (admin role)
#   customer@example.com  (normal customer)
# Leave empty to have the seed script generate them and print them once.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

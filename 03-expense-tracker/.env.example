# Copy this file to .env and fill in JWT_SECRET before running.
# Never commit the real .env file.

PORT=3003
DB_FILE=data/expenses.db

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If it is missing, the server makes a temporary one and everyone is logged out on restart.
JWT_SECRET=

# Set to true when serving over HTTPS so the login cookie gets the Secure flag.
COOKIE_SECURE=false

# Password for the demo account created by `npm run seed` (demo@example.com).
# Leave empty and the seed script will generate one and print it.
SEED_PASSWORD=
